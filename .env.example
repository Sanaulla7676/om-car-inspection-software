NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional for trusted maintenance scripts only. Never use this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only HMAC signing key for the separate /admin portal. Generate a random value of at least 32 bytes.
OMCAR_ADMIN_RPC_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=

# India vehicle registry lookup
# Chassis-only flow: the backend calls the configured provider securely; never expose keys in the browser.
VEHICLE_LOOKUP_PROVIDER=decentro
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
VEHICLE_LOOKUP_URL=https://in.decentro.tech/v2/bytes/converter/chassis/rc

# Alternative provider adapter (optional)
SUREPASS_API_KEY=
VEHICLE_PROVIDER_URL=
VEHICLE_PROVIDER_TOKEN=

# Real WhatsApp OTP delivery requires a WhatsApp Business Cloud API token,
# phone-number ID and an approved template with one body text-code parameter.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=omcar_admin_verification
WHATSAPP_OTP_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
